{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "psyche-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "psyche-prod-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview"
      ],
      "port": 4173
    },
    {
      "name": "psyche-dev-v2",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:v2"
      ],
      "port": 5174
    },
    {
      "name": "psyche-prod-check",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "--mode",
        "production",
        "--port",
        "5175",
        "--strictPort"
      ],
      "port": 5175
    }
  ]
}
